{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "awesome-typesafe-jev entries",
  "type": "object",
  "required": ["updated", "entries"],
  "properties": {
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url", "category", "what", "added"],
        "properties": {
          "name": { "type": "string" },
          "repo": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" },
          "url": { "type": "string", "pattern": "^https://" },
          "category": { "enum": ["browser-computer-use", "agent-tooling", "game", "benchmark-research", "application", "official", "sdk"] },
          "what": { "type": "string", "maxLength": 160 },
          "evidence": { "type": "string" },
          "concern": { "type": "string" },
          "pick": { "type": "boolean" },
          "live": { "type": "string" },
          "demo": { "type": "string" },
          "media": { "type": "object", "required": ["src", "credit"] },
          "added": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
